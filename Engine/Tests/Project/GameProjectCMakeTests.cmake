# 通常の Engine Build Tree と競合しない独立 Fixture で Project の CMake 契約を検証する
foreach(taskKey IN ITEMS CUE_SOURCE_ROOT CUE_FIXTURE_ROOT CUE_GENERATOR CUE_CONFIGURATION)
    if(NOT DEFINED ${taskKey} OR "${${taskKey}}" STREQUAL "")
        message(FATAL_ERROR "Game CMake test argument is missing: ${taskKey}")
    endif()
endforeach()
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef taskNonce)
set(taskRoot "${CUE_FIXTURE_ROOT}/${taskNonce}")
set(taskEngine "${taskRoot}/Engine")
set(taskGame "${taskRoot}/日本語 Game")
set(taskBuild "${taskRoot}/BuildTree")
set(taskProject "${taskGame}/Game.cueproj")
file(MAKE_DIRECTORY "${taskEngine}" "${taskGame}/Source" "${taskGame}/Content" "${taskGame}/EmptySource")
set(taskBootstrap [=[
cmake_minimum_required(VERSION 4.2)
project(CueGameProjectFixture LANGUAGES CXX)
add_library(Cue.Script INTERFACE)
include("@CUE_SOURCE_ROOT@/cmake/CueGameProject.cmake")
cue_add_game_project("${CUE_GAME_PROJECT}")
]=])
string(CONFIGURE "${taskBootstrap}" taskBootstrap @ONLY)
file(WRITE "${taskEngine}/CMakeLists.txt" "${taskBootstrap}")
file(WRITE "${taskGame}/Source/CMakeLists.txt" "cue_add_game_module(OtherGame SOURCES Game.cpp)\n")
file(WRITE "${taskGame}/Source/Game.cpp"
    "/// @brief 独立 Project の DLL / Static 共通 Source を識別する\nextern \"C\" __declspec(dllexport) int game_value() { return 42; }\n")
file(WRITE "${taskGame}/CMakeLists.txt" "message(FATAL_ERROR \"UNSAFE_SOURCE_EXECUTED\")\n")
set(taskDescriptor "formatVersion=1\nprojectId=7f533c49-d416-47ea-98c1-026822b1e6ed\nname=日本語 Project; $<display only>\napplicationName=OtherGame\nsourceRoot=Source\ncontentRoot=Content\ngameTarget=OtherGame\n")
file(WRITE "${taskProject}" "${taskDescriptor}")
set(taskConfigure "${CMAKE_COMMAND}" -S "${taskEngine}" -B "${taskBuild}" -G "${CUE_GENERATOR}"
    "-DCMAKE_CONFIGURATION_TYPES=Debug;Development;Release" "-DCMAKE_BUILD_TYPE=${CUE_CONFIGURATION}"
    "-DCUE_GAME_PLATFORM=Windows" "-DCUE_GAME_ARCHITECTURE=x64"
    "-DCUE_GAME_PROJECT=${taskProject}")
if(DEFINED CUE_GENERATOR_PLATFORM AND NOT CUE_GENERATOR_PLATFORM STREQUAL "")
    list(APPEND taskConfigure -A "${CUE_GENERATOR_PLATFORM}")
endif()

# Execute Process への List 展開では Configuration の semicolon だけを明示的に Escape する
string(REPLACE "Debug;Development;Release" "Debug\\;Development\\;Release" taskConfigure "${taskConfigure}")
execute_process(COMMAND ${taskConfigure} RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
if(NOT taskResult EQUAL 0)
    message(FATAL_ERROR "Game CMake valid configure failed: ${taskOutput}\n${taskError}")
endif()
set(taskManifest "${taskGame}/Build/Windows/x64/${CUE_CONFIGURATION}/GameModule.cuebuild")
if(EXISTS "${taskManifest}")
    message(FATAL_ERROR "Configure published a manifest before the game was built")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${taskBuild}" --config "${CUE_CONFIGURATION}"
    --target Cue.GameProjectBuild RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
if(NOT taskResult EQUAL 0 OR NOT EXISTS "${taskManifest}")
    message(FATAL_ERROR "Game CMake valid build failed: ${taskOutput}\n${taskError}")
endif()
file(READ "${taskManifest}" taskBaseline)
file(SHA256 "${taskGame}/Build/Windows/x64/${CUE_CONFIGURATION}/Runtime/OtherGame.dll" taskModuleHash)
file(SHA256 "${taskGame}/Build/Windows/x64/${CUE_CONFIGURATION}/Libraries/OtherGameStatic.lib" taskStaticHash)
if(NOT EXISTS "${taskGame}/Build/Windows/x64/${CUE_CONFIGURATION}/Runtime/OtherGame.pdb")
    message(FATAL_ERROR "Game CMake did not place the matching developer PDB next to the game DLL")
endif()
if(NOT taskBaseline MATCHES "moduleSha256=${taskModuleHash}" OR
   NOT taskBaseline MATCHES "staticLibrarySha256=${taskStaticHash}" OR
   NOT taskBaseline MATCHES "gameTarget=OtherGame" OR
   NOT taskBaseline MATCHES "configuration=${CUE_CONFIGURATION}")
    message(FATAL_ERROR "Game CMake manifest does not describe the completed artifacts")
endif()

# 失敗した Configure で既存の公開済み成果物や Manifest を書き換えない
foreach(taskCase IN ITEMS reserved missing_source overlap trailing_alias target_mismatch duplicate empty invalid_utf8
                          unsupported_platform unsupported_architecture unspecified_platform)
    set(taskInvalid "${taskDescriptor}")
    if(taskCase STREQUAL reserved)
        string(REPLACE "gameTarget=OtherGame" "gameTarget=CON" taskInvalid "${taskInvalid}")
    elseif(taskCase STREQUAL missing_source)
        string(REPLACE "sourceRoot=Source" "sourceRoot=EmptySource" taskInvalid "${taskInvalid}")
    elseif(taskCase STREQUAL overlap)
        string(REPLACE "sourceRoot=Source" "sourceRoot=." taskInvalid "${taskInvalid}")
    elseif(taskCase STREQUAL trailing_alias)
        string(REPLACE "sourceRoot=Source" "sourceRoot=Build." taskInvalid "${taskInvalid}")
    elseif(taskCase STREQUAL target_mismatch)
        string(REPLACE "gameTarget=OtherGame" "gameTarget=MissingGame" taskInvalid "${taskInvalid}")
    elseif(taskCase STREQUAL duplicate)
        string(APPEND taskInvalid "gameTarget=OtherGame\n")
    elseif(taskCase STREQUAL empty)
        string(REPLACE "gameTarget=OtherGame" "gameTarget=" taskInvalid "${taskInvalid}")
    elseif(taskCase STREQUAL invalid_utf8)
        string(ASCII 255 taskInvalidByte)
        string(APPEND taskInvalid "#${taskInvalidByte}\n")
    endif()
    file(WRITE "${taskProject}" "${taskInvalid}")
    set(taskExtra)
    if(taskCase STREQUAL unsupported_platform)
        set(taskExtra "-DCUE_GAME_PLATFORM=UnimplementedPlatform")
    elseif(taskCase STREQUAL unsupported_architecture)
        set(taskExtra "-DCUE_GAME_ARCHITECTURE=arm64")
    elseif(taskCase STREQUAL unspecified_platform)
        set(taskExtra "-DCUE_GAME_PLATFORM=")
    endif()
    execute_process(COMMAND ${taskConfigure} ${taskExtra}
        RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
    if(taskResult EQUAL 0 OR "${taskOutput}${taskError}" MATCHES "UNSAFE_SOURCE_EXECUTED")
        message(FATAL_ERROR "Game CMake invalid descriptor was executed or accepted: ${taskCase}")
    endif()
    file(READ "${taskManifest}" taskAfter)
    if(NOT taskAfter STREQUAL taskBaseline)
        message(FATAL_ERROR "Game CMake failed configure changed a published manifest: ${taskCase}")
    endif()
endforeach()
file(WRITE "${taskProject}" "${taskDescriptor}")
message(STATUS "Game CMake Unicode build, manifest and rejected configurations passed: ${taskRoot}")
