cmake_minimum_required(VERSION 4.2)

# Engine の通常 Build と競合しない小さい Host Fixture で、静的 Link と配布処理だけを検証する
foreach(taskKey IN ITEMS CUE_SOURCE_ROOT CUE_FIXTURE_ROOT CUE_GENERATOR CUE_CONFIGURATION)
    if(NOT DEFINED ${taskKey} OR "${${taskKey}}" STREQUAL "")
        message(FATAL_ERROR "Game App CMake test argument is missing: ${taskKey}")
    endif()
endforeach()
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef taskNonce)
set(taskRoot "${CUE_FIXTURE_ROOT}/${taskNonce}")
set(taskEngine "${taskRoot}/Engine")
set(taskGame "${taskRoot}/日本語 App")
set(taskBuild "${taskRoot}/BuildTree")
set(taskProject "${taskGame}/Game.cueproj")
file(MAKE_DIRECTORY "${taskEngine}" "${taskGame}/Source" "${taskGame}/Content/Scenes")
set(taskBootstrap [=[
cmake_minimum_required(VERSION 4.2)
project(CueGameAppFixture LANGUAGES CXX)
add_library(Cue.Script INTERFACE)
add_library(Cue.GameHost.Windows INTERFACE)
include("@CUE_SOURCE_ROOT@/cmake/CueGameProject.cmake")
set_property(GLOBAL PROPERTY CUE_GAME_Windows_MAIN_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/Main.cpp")
function(cue_copy_shader_runtime a_target)
    add_custom_target(${a_target}.ShaderRuntime
        COMMAND "${CMAKE_COMMAND}" -DOUT=$<TARGET_FILE_DIR:${a_target}>
            -P "${CMAKE_CURRENT_SOURCE_DIR}/StageRuntime.cmake" VERBATIM)
    add_dependencies(${a_target} ${a_target}.ShaderRuntime)
endfunction()
cue_add_game_project("${CUE_GAME_PROJECT}")
]=])
string(CONFIGURE "${taskBootstrap}" taskBootstrap @ONLY)
file(WRITE "${taskEngine}/CMakeLists.txt" "${taskBootstrap}")
file(WRITE "${taskEngine}/Main.cpp" "#include <windows.h>\nextern \"C\" int game_value();\nint WINAPI wWinMain(HINSTANCE,HINSTANCE,PWSTR,int) { return game_value() == 42 ? 0 : 1; }\n")
file(WRITE "${taskEngine}/StageRuntime.cmake" [=[
file(MAKE_DIRECTORY "${OUT}/EngineResources/Shader/Hlsl")
foreach(name IN ITEMS dxcompiler.dll dxil.dll WinPixEventRuntime.dll WinPixEventRuntime-MIT.txt
    WinPixEventRuntime-ThirdPartyNotices.txt DirectXShaderCompiler-MS.txt DirectXShaderCompiler-LLVM.txt
    DirectXShaderCompiler-MIT.txt DirectXShaderCompiler-HLSL.txt)
    file(WRITE "${OUT}/${name}" "Fixture runtime\n")
endforeach()
file(WRITE "${OUT}/EngineResources/Shader/Hlsl/Fixture.hlsl" "Fixture shader\n")
]=])
file(WRITE "${taskGame}/Source/CMakeLists.txt" "cue_add_game_module(OtherGame SOURCES Game.cpp)\n")
file(WRITE "${taskGame}/Source/Game.cpp" "extern \"C\" __declspec(dllexport) int game_value() { return 42; }\n")
set(taskScene "${taskGame}/Content/Scenes/Start.cuescene")
file(WRITE "${taskScene}" "Fixture scene original\n")
set(taskDescriptor "formatVersion=1\nprojectId=8f533c49-d416-47ea-98c1-026822b1e6ed\nname=日本語 App; $<literal title>\napplicationName=OtherApp\nsourceRoot=Source\ncontentRoot=Content\nstartupScene=Scenes/Start.cuescene\ngameTarget=OtherGame\n")
file(WRITE "${taskProject}" "${taskDescriptor}")
file(SHA256 "${taskScene}" taskSourceHash)
set(taskConfigure "${CMAKE_COMMAND}" -S "${taskEngine}" -B "${taskBuild}" -G "${CUE_GENERATOR}"
    "-DCMAKE_CONFIGURATION_TYPES=Debug;Development;Release" "-DCMAKE_BUILD_TYPE=${CUE_CONFIGURATION}"
    "-DCUE_GAME_PLATFORM=Windows" "-DCUE_GAME_ARCHITECTURE=x64" "-DCUE_GAME_PROJECT=${taskProject}")
if(DEFINED CUE_GENERATOR_PLATFORM AND NOT CUE_GENERATOR_PLATFORM STREQUAL "")
    list(APPEND taskConfigure -A "${CUE_GENERATOR_PLATFORM}")
endif()
string(REPLACE "Debug;Development;Release" "Debug\\;Development\\;Release" taskConfigure "${taskConfigure}")
execute_process(COMMAND ${taskConfigure} RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
if(NOT taskResult EQUAL 0)
    message(FATAL_ERROR "Game App configure failed: ${taskOutput}\n${taskError}")
endif()
set(taskApp "${taskGame}/Build/Windows/x64/${CUE_CONFIGURATION}/App")
# 改名前の配布先を利用者の既存成果物として残し、新しい App の Build で触れない
set(taskLegacyOutput "${taskGame}/Build/Windows/x64/${CUE_CONFIGURATION}/Player")
file(MAKE_DIRECTORY "${taskLegacyOutput}")
file(WRITE "${taskLegacyOutput}/UserNote.txt" "Previous output must remain\n")
if(EXISTS "${taskApp}/GamePackage.cuepackage")
    message(FATAL_ERROR "Configure incorrectly published a completed App")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${taskBuild}" --config "${CUE_CONFIGURATION}" --target OtherApp
    RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
if(NOT taskResult EQUAL 0)
    message(FATAL_ERROR "Game App static build failed: ${taskOutput}\n${taskError}")
endif()
foreach(taskFile IN ITEMS OtherApp.exe GameStartup.cueapp GamePackage.cuepackage Content/Scenes/Start.cuescene
    dxcompiler.dll dxil.dll EngineResources/Shader/Hlsl/Fixture.hlsl
    DirectXShaderCompiler-MS.txt DirectXShaderCompiler-LLVM.txt DirectXShaderCompiler-MIT.txt DirectXShaderCompiler-HLSL.txt)
    if(NOT EXISTS "${taskApp}/${taskFile}")
        message(FATAL_ERROR "Game App package file is missing: ${taskFile}")
    endif()
endforeach()
foreach(taskFile IN ITEMS WinPixEventRuntime.dll WinPixEventRuntime-MIT.txt WinPixEventRuntime-ThirdPartyNotices.txt)
    if(CUE_CONFIGURATION STREQUAL "Release")
        if(EXISTS "${taskApp}/${taskFile}")
            message(FATAL_ERROR "Release App unexpectedly contains PIX: ${taskFile}")
        endif()
    elseif(NOT EXISTS "${taskApp}/${taskFile}")
        message(FATAL_ERROR "Development App is missing PIX: ${taskFile}")
    endif()
endforeach()
file(GLOB_RECURSE taskDebugFiles "${taskApp}/*.pdb" "${taskApp}/*.lib" "${taskApp}/*.exp")
if(taskDebugFiles)
    message(FATAL_ERROR "App contains build-only artifacts: ${taskDebugFiles}")
endif()
if(EXISTS "${taskApp}/OtherGame.dll" OR EXISTS "${taskGame}/Build/Windows/x64/${CUE_CONFIGURATION}/Runtime/OtherGame.dll")
    message(FATAL_ERROR "Building the static App unexpectedly built or packaged the game DLL")
endif()
file(READ "${taskApp}/GameStartup.cueapp" taskStartup)
string(FIND "${taskStartup}" "windowTitle=日本語 App; $<literal title>\n" taskTitle)
if(taskTitle LESS 0 OR NOT taskStartup MATCHES "configuration=${CUE_CONFIGURATION}")
    message(FATAL_ERROR "Game App startup settings lost the literal title or selected configuration")
endif()
file(SHA256 "${taskScene}" taskAfterHash)
if(NOT taskAfterHash STREQUAL taskSourceHash)
    message(FATAL_ERROR "Game App publication changed the original scene")
endif()
# 既存 Editor 成果物の Manifest を用意し、App の再 Build が Static を更新する状況を作る
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${taskBuild}" --config "${CUE_CONFIGURATION}"
    --target Cue.GameProjectBuild RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
if(NOT taskResult EQUAL 0)
    message(FATAL_ERROR "Game module fixture build failed: ${taskOutput}\n${taskError}")
endif()
set(taskArtifacts "${taskGame}/Build/Windows/x64/${CUE_CONFIGURATION}")
file(SHA256 "${taskArtifacts}/Libraries/OtherGameStatic.lib" taskPreviousStaticHash)
# 返り値は維持し、最適化されない観測可能な変数で Object の変化を保証する
file(WRITE "${taskGame}/Source/Game.cpp"
    "extern \"C\" __declspec(dllexport) int game_value() { volatile int value = 41; return value + 1; }\n")
# Scene だけの変更も専用 Package Target で回収する
file(WRITE "${taskScene}" "Fixture scene changed\n")
file(WRITE "${taskApp}/LegacyGame.dll" "Old owned game DLL\n")
file(APPEND "${taskApp}/.cue-app-files" "LegacyGame.dll\n")
# 旧版が配布した PIX も、所有リストに載る File だけを Release から回収する
if(CUE_CONFIGURATION STREQUAL "Release")
    foreach(taskFile IN ITEMS WinPixEventRuntime.dll WinPixEventRuntime-MIT.txt WinPixEventRuntime-ThirdPartyNotices.txt)
        file(WRITE "${taskApp}/${taskFile}" "Previously packaged PIX\n")
        file(APPEND "${taskApp}/.cue-app-files" "${taskFile}\n")
    endforeach()
endif()
file(WRITE "${taskApp}/UserNote.txt" "User file must remain\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${taskBuild}" --config "${CUE_CONFIGURATION}"
    --target Cue.GameAppPackage RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
if(NOT taskResult EQUAL 0)
    message(FATAL_ERROR "Game App repackaging failed: ${taskOutput}\n${taskError}")
endif()
file(SHA256 "${taskArtifacts}/Libraries/OtherGameStatic.lib" taskCurrentStaticHash)
file(SHA256 "${taskArtifacts}/Runtime/OtherGame.dll" taskCurrentModuleHash)
file(READ "${taskArtifacts}/GameModule.cuebuild" taskArtifactManifest)
if(taskCurrentStaticHash STREQUAL taskPreviousStaticHash
   OR NOT taskArtifactManifest MATCHES "staticLibrarySha256=${taskCurrentStaticHash}\n"
   OR NOT taskArtifactManifest MATCHES "moduleSha256=${taskCurrentModuleHash}\n")
    message(FATAL_ERROR "App build did not republish matching game artifact hashes")
endif()
file(READ "${taskApp}/Content/Scenes/Start.cuescene" taskCopied)
if(NOT taskCopied STREQUAL "Fixture scene changed\n")
    message(FATAL_ERROR "Game App repackaging ignored a changed scene")
endif()
if(EXISTS "${taskApp}/LegacyGame.dll" OR NOT EXISTS "${taskApp}/UserNote.txt")
    message(FATAL_ERROR "Game App repackaging did not limit cleanup to the previous owned payload")
endif()
if(CUE_CONFIGURATION STREQUAL "Release")
    foreach(taskFile IN ITEMS WinPixEventRuntime.dll WinPixEventRuntime-MIT.txt WinPixEventRuntime-ThirdPartyNotices.txt)
        if(EXISTS "${taskApp}/${taskFile}")
            message(FATAL_ERROR "Release repackaging retained previously owned PIX: ${taskFile}")
        endif()
    endforeach()
endif()
# Copy 途中の失敗では完成 Marker を残さない。Fixture 内の File だけを Directory に置き換えて再現する
file(REMOVE "${taskApp}/Content/Scenes/Start.cuescene")
file(MAKE_DIRECTORY "${taskApp}/Content/Scenes/Start.cuescene")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${taskBuild}" --config "${CUE_CONFIGURATION}"
    --target Cue.GameAppPackage RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
if(taskResult EQUAL 0 OR EXISTS "${taskApp}/GamePackage.cuepackage")
    message(FATAL_ERROR "Game App copy failure left a completed package marker")
endif()
# Directory は Fixture 内の別名へ移し、再帰削除を使わず再試行を確認する
file(RENAME "${taskApp}/Content/Scenes/Start.cuescene" "${taskApp}/Content/Scenes/BlockedSceneDirectory")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${taskBuild}" --config "${CUE_CONFIGURATION}"
    --target Cue.GameAppPackage RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
if(NOT taskResult EQUAL 0 OR NOT EXISTS "${taskApp}/GamePackage.cuepackage")
    message(FATAL_ERROR "Game App publication could not recover after a copy failure: ${taskOutput}\n${taskError}")
endif()
execute_process(COMMAND "${taskApp}/OtherApp.exe" WORKING_DIRECTORY "${taskRoot}"
    RESULT_VARIABLE taskResult TIMEOUT 5)
if(NOT taskResult EQUAL 0)
    message(FATAL_ERROR "Game App linked against its static game could not run independently")
endif()
message(STATUS "Game App static build and publication passed: ${taskApp}")
file(READ "${taskLegacyOutput}/UserNote.txt" taskLegacyNote)
if(NOT taskLegacyNote STREQUAL "Previous output must remain\n")
    message(FATAL_ERROR "App publication changed the previous Player directory")
endif()
