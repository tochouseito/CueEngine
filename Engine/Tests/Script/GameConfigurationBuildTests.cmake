# 一つの Native Host と、実際に異なる構成で生成した Game DLL の ABI 境界を検証する
foreach(taskKey IN ITEMS CUE_SOURCE_ROOT CUE_TEST_ROOT CUE_GENERATOR CUE_PLAY_HOST CUE_TEST_EXE)
    if(NOT DEFINED ${taskKey} OR "${${taskKey}}" STREQUAL "")
        message(FATAL_ERROR "Game configuration test argument is missing: ${taskKey}")
    endif()
endforeach()
if(NOT CUE_GENERATOR MATCHES "^Visual Studio " AND NOT CUE_GENERATOR STREQUAL "Ninja Multi-Config")
    message(FATAL_ERROR "Game configuration tests require a multi-configuration generator")
endif()
foreach(taskFile IN ITEMS "${CUE_PLAY_HOST}" "${CUE_TEST_EXE}")
    if(NOT IS_ABSOLUTE "${taskFile}" OR NOT EXISTS "${taskFile}" OR IS_DIRECTORY "${taskFile}")
        message(FATAL_ERROR "Game configuration test executable is invalid: ${taskFile}")
    endif()
endforeach()
get_filename_component(taskAllowedRoot "${CUE_SOURCE_ROOT}/out/tests" ABSOLUTE)
get_filename_component(taskTestBase "${CUE_TEST_ROOT}" ABSOLUTE)
cmake_path(IS_PREFIX taskAllowedRoot "${taskTestBase}" NORMALIZE taskIsInside)
if(NOT taskIsInside)
    message(FATAL_ERROR "Game configuration fixtures must stay within the repository out/tests directory")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef taskNonce)
set(taskRoot "${taskTestBase}/${taskNonce}")
set(taskGame "${taskRoot}/Game")
set(taskTree "${taskGame}/Intermediate/GameConfiguration")
if(EXISTS "${taskRoot}")
    message(FATAL_ERROR "Game configuration fixture already exists: ${taskRoot}")
endif()
file(MAKE_DIRECTORY "${taskGame}/Source" "${taskGame}/Content/Scenes")
file(READ "${CUE_SOURCE_ROOT}/Engine/Version.json" taskVersionJson)
string(JSON taskVersion GET "${taskVersionJson}" version)
file(WRITE "${taskGame}/GameConfiguration.cueproj"
    "formatVersion=2\nprojectId=6a533c49-d416-47ea-98c1-026822b1e6ed\nname=Game Configuration Fixture\napplicationName=GameConfigurationFixture\nsourceRoot=Source\ncontentRoot=Content\nstartupScene=Scenes/Start.cuescene\ngameTarget=CueGameConfigFixture\nengineVersion=${taskVersion}\n")
# Production SDK の同じ Module Adapter を各 CRT / 最適化設定で生成する。元 Fixture は変更しない
file(COPY_FILE "${CUE_SOURCE_ROOT}/Engine/Tests/Script/PlayFailureGame.cpp" "${taskGame}/Source/Game.cpp")
file(WRITE "${taskGame}/Source/CMakeLists.txt" [=[
cue_add_game_module(CueGameConfigFixture SOURCES "${PROJECT_SOURCE_DIR}/Source/Game.cpp")
]=])
file(WRITE "${taskGame}/Content/Scenes/Start.cuescene"
    "formatVersion=1\nsceneId=8d94c2b1-9b6a-435c-ade7-c01f473c3951\nname=Game Configuration Fixture\n")
file(WRITE "${taskGame}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 4.2)
project(GameConfigurationFixture LANGUAGES CXX)
set(CMAKE_CONFIGURATION_TYPES "Debug;Development;Release" CACHE STRING "Fixture configurations" FORCE)
set(CUE_GAME_BUILD_APP OFF CACHE BOOL "Script only configuration fixture" FORCE)
include("${CUE_ENGINE_ROOT}/cmake/CueGameSdk.cmake")
cue_add_standalone_game_project("${CMAKE_SOURCE_DIR}/GameConfiguration.cueproj")
foreach(taskForbidden IN ITEMS CueEditorHost Cue.EditorHost Cue.Editor.Ui CuePlayHost Cue.GameHost.Windows
        Cue.WindowsHost Cue.Renderer.DX12)
    if(TARGET "${taskForbidden}")
        message(FATAL_ERROR "A Host or renderer target leaked into the Script-only fixture")
    endif()
endforeach()
if(DEFINED CMAKE_TOOLCHAIN_FILE AND NOT "${CMAKE_TOOLCHAIN_FILE}" STREQUAL "")
    message(FATAL_ERROR "The Script-only fixture unexpectedly depends on an external toolchain")
endif()
]=])
set(taskConfigure "${CMAKE_COMMAND}" -S "${taskGame}" -B "${taskTree}" -G "${CUE_GENERATOR}"
    "-DCUE_ENGINE_ROOT=${CUE_SOURCE_ROOT}" "-DCUE_GAME_PLATFORM=Windows" "-DCUE_GAME_ARCHITECTURE=x64")
if(DEFINED CUE_GENERATOR_PLATFORM AND NOT CUE_GENERATOR_PLATFORM STREQUAL "")
    list(APPEND taskConfigure -A "${CUE_GENERATOR_PLATFORM}")
endif()
execute_process(COMMAND ${taskConfigure} RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
file(WRITE "${taskRoot}/Configure.log" "${taskOutput}\n${taskError}")
if(NOT taskResult EQUAL 0)
    message(FATAL_ERROR "Game configuration fixture configure failed: ${taskOutput}\n${taskError}")
endif()
set(taskModules)
foreach(taskConfiguration IN ITEMS Debug Development Release)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${taskTree}" --config "${taskConfiguration}"
        --target CueGameConfigFixture
        RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
    file(WRITE "${taskRoot}/${taskConfiguration}-Build.log" "${taskOutput}\n${taskError}")
    if(NOT taskResult EQUAL 0)
        message(FATAL_ERROR "Game ${taskConfiguration} build failed: ${taskOutput}\n${taskError}")
    endif()
    set(taskModule "${taskGame}/Build/Windows/x64/${taskConfiguration}/Runtime/CueGameConfigFixture.dll")
    if(NOT EXISTS "${taskModule}" OR NOT EXISTS "${taskGame}/Build/Windows/x64/${taskConfiguration}/Runtime/CueGameConfigFixture.pdb")
        message(FATAL_ERROR "Game ${taskConfiguration} DLL or matching PDB is missing")
    endif()
    list(APPEND taskModules "${taskModule}")
endforeach()
list(JOIN taskModules "\n" taskModuleLines)
file(WRITE "${taskRoot}/ModulePaths.txt" "${taskModuleLines}\n")
message(STATUS "Retained Game configuration fixtures: ${taskRoot}")
execute_process(COMMAND "${CUE_TEST_EXE}" "${CUE_PLAY_HOST}" ${taskModules}
    RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
file(WRITE "${taskRoot}/CrossConfiguration.log" "${taskOutput}\n${taskError}")
if(NOT taskResult EQUAL 0)
    message(FATAL_ERROR "Cross-configuration Play failed (${taskResult}): ${taskOutput}\n${taskError}")
endif()
message(STATUS "Debug / Development / Release DLL Metadata, Play, property, lifetime and failure checks passed")
