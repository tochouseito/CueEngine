# Compiler を起動せず、C++ と同じ v1 / v2 の Version 境界を独立した CMake Process で検証する
foreach(taskKey IN ITEMS CUE_SOURCE_ROOT CUE_FIXTURE_ROOT)
    if(NOT DEFINED ${taskKey} OR "${${taskKey}}" STREQUAL "")
        message(FATAL_ERROR "Project version test argument is missing: ${taskKey}")
    endif()
endforeach()
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef taskNonce)
set(taskRoot "${CUE_FIXTURE_ROOT}/${taskNonce}")
file(MAKE_DIRECTORY "${taskRoot}")
file(WRITE "${taskRoot}/Validate.cmake"
    "include(\"${CUE_SOURCE_ROOT}/cmake/CueGameProject.cmake\")\nset(CUE_ENGINE_VERSION \"1.2.3-preview.1\")\ncue_add_game_project(\"${taskRoot}/Game.cueproj\")\n")
set(taskBody "\nprojectId=11111111-1111-4111-8111-111111111111\nname=Game\napplicationName=Game\nsourceRoot=Source\ncontentRoot=Content\n")
foreach(taskCase IN ITEMS legacy version2 mismatch missing invalid leading_zero legacy_pin future)
    set(taskDescriptor "formatVersion=2${taskBody}engineVersion=1.2.3-preview.1\n")
    set(taskExpected TRUE)
    if(taskCase STREQUAL legacy)
        set(taskDescriptor "formatVersion=1${taskBody}")
    elseif(taskCase STREQUAL mismatch)
        string(REPLACE "engineVersion=1.2.3-preview.1" "engineVersion=1.2.4" taskDescriptor "${taskDescriptor}")
        set(taskExpected FALSE)
    elseif(taskCase STREQUAL missing)
        set(taskDescriptor "formatVersion=2${taskBody}")
        set(taskExpected FALSE)
    elseif(taskCase STREQUAL invalid)
        string(REPLACE "engineVersion=1.2.3-preview.1" "engineVersion=1.2" taskDescriptor "${taskDescriptor}")
        set(taskExpected FALSE)
    elseif(taskCase STREQUAL leading_zero)
        string(REPLACE "engineVersion=1.2.3-preview.1" "engineVersion=1.2.3-preview.01" taskDescriptor "${taskDescriptor}")
        set(taskExpected FALSE)
    elseif(taskCase STREQUAL legacy_pin)
        set(taskDescriptor "formatVersion=1${taskBody}engineVersion=1.2.3-preview.1\n")
        set(taskExpected FALSE)
    elseif(taskCase STREQUAL future)
        set(taskDescriptor "formatVersion=3${taskBody}")
        set(taskExpected FALSE)
    endif()
    file(WRITE "${taskRoot}/Game.cueproj" "${taskDescriptor}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${taskRoot}/Validate.cmake"
        RESULT_VARIABLE taskResult OUTPUT_VARIABLE taskOutput ERROR_VARIABLE taskError)
    if((taskExpected AND NOT taskResult EQUAL 0) OR (NOT taskExpected AND taskResult EQUAL 0))
        message(FATAL_ERROR "Project CMake case ${taskCase} had unexpected result ${taskResult}: ${taskOutput}\n${taskError}")
    endif()
endforeach()
