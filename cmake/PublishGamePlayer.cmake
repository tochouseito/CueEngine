cmake_minimum_required(VERSION 4.2)

# 成功 Marker の公開までゲームを起動可能にしない。Source / Content を変更せず、専用 Player だけを更新する
foreach(taskRequired IN ITEMS CUE_PLAYER_SOURCE CUE_PLAYER_EXECUTABLE CUE_PLAYER_OUTPUT
    CUE_PLAYER_CONFIGURATION CUE_PLAYER_PROJECT_ID CUE_PLAYER_APPLICATION CUE_PLAYER_EXECUTABLE_NAME
    CUE_STARTUP_TEMPLATE CUE_PACKAGE_TEMPLATE CUE_STARTUP_SCENE CUE_STARTUP_SCENE_RELATIVE
    CUE_PLAYER_RUNTIME_LIST CUE_PLAYER_LICENSE_LIST)
    if(NOT DEFINED ${taskRequired} OR "${${taskRequired}}" STREQUAL "")
        message(FATAL_ERROR "Cue player publication argument is missing: ${taskRequired}")
    endif()
endforeach()
if(NOT CUE_PLAYER_CONFIGURATION MATCHES "^(Debug|Development|Release)$")
    message(FATAL_ERROR "Cue player configuration is unsupported")
endif()
get_filename_component(taskOutput "${CUE_PLAYER_OUTPUT}" ABSOLUTE)
get_filename_component(taskSource "${CUE_PLAYER_SOURCE}" ABSOLUTE)
if(taskOutput STREQUAL taskSource OR NOT taskOutput MATCHES "/Player$")
    message(FATAL_ERROR "Cue player publication requires a dedicated Player directory")
endif()

# 出力先の Link / Junction と File を越えて書き込まない
function(cue_player_validate_path a_path)
    get_filename_component(taskPath "${a_path}" ABSOLUTE)
    while(NOT EXISTS "${taskPath}")
        get_filename_component(taskParent "${taskPath}" DIRECTORY)
        if(taskParent STREQUAL taskPath OR taskParent STREQUAL "")
            message(FATAL_ERROR "Cue player path has no existing parent")
        endif()
        set(taskPath "${taskParent}")
    endwhile()
    get_filename_component(taskReal "${taskPath}" REALPATH)
    string(TOLOWER "${taskPath}" taskExpected)
    string(TOLOWER "${taskReal}" taskActual)
    if(NOT taskExpected STREQUAL taskActual)
        message(FATAL_ERROR "Cue player path traverses a link or junction: ${a_path}")
    endif()
endfunction()

# 生成した相対 File 名だけを受け付け、前回の所有リストを削除 Command として解釈しない
function(cue_player_validate_relative a_relative)
    if(a_relative STREQUAL ".cue-player-owner" OR a_relative STREQUAL ".cue-player-files")
        message(FATAL_ERROR "Cue player ownership metadata cannot appear in the owned payload list")
    endif()
    if(a_relative STREQUAL "" OR IS_ABSOLUTE "${a_relative}" OR a_relative MATCHES "(^|/)\\.\\.(/|$)|:|\\\\|;|\\$<")
        message(FATAL_ERROR "Cue player owned file path is invalid: ${a_relative}")
    endif()
    get_filename_component(taskResolved "${taskOutput}/${a_relative}" ABSOLUTE)
    string(TOLOWER "${taskOutput}/" taskPrefix)
    string(TOLOWER "${taskResolved}" taskCompared)
    string(FIND "${taskCompared}" "${taskPrefix}" taskPosition)
    if(NOT taskPosition EQUAL 0)
        message(FATAL_ERROR "Cue player owned file is outside its directory")
    endif()
    cue_player_validate_path("${taskResolved}")
endfunction()

# 完成した File を同じ Directory の一意な一時名から公開する
function(cue_player_publish_text a_file a_text)
    string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef taskNonce)
    set(taskTemporary "${a_file}.${taskNonce}.tmp")
    file(WRITE "${taskTemporary}" "${a_text}")
    file(RENAME "${taskTemporary}" "${a_file}" RESULT taskResult)
    if(NOT taskResult STREQUAL "0")
        file(REMOVE "${taskTemporary}")
        message(FATAL_ERROR "Cue player file publication failed: ${taskResult}")
    endif()
endfunction()

cue_player_validate_path("${taskOutput}")
if(EXISTS "${taskOutput}" AND NOT IS_DIRECTORY "${taskOutput}")
    message(FATAL_ERROR "Cue Player output is a regular file")
endif()
set(taskOwner "${taskOutput}/.cue-player-owner")
set(taskOwnedList "${taskOutput}/.cue-player-files")
set(taskMarker "${taskOutput}/GamePackage.cuepackage")
set(taskOwnerValue "${CUE_PLAYER_PROJECT_ID}\n")
if(EXISTS "${taskOwner}")
    file(READ "${taskOwner}" taskPreviousOwner)
    if(NOT taskPreviousOwner STREQUAL taskOwnerValue)
        message(FATAL_ERROR "Cue Player output belongs to another project")
    endif()
elseif(EXISTS "${taskOutput}")
    file(GLOB taskExisting LIST_DIRECTORIES TRUE "${taskOutput}/*" "${taskOutput}/.*")
    if(taskExisting)
        message(FATAL_ERROR "Cue will not overwrite a non-empty Player directory without its owner marker")
    endif()
endif()
file(MAKE_DIRECTORY "${taskOutput}")
cue_player_publish_text("${taskOwner}" "${taskOwnerValue}")

file(STRINGS "${CUE_PLAYER_RUNTIME_LIST}" taskRuntimeFiles ENCODING UTF-8)
file(STRINGS "${CUE_PLAYER_LICENSE_LIST}" taskLicenseFiles ENCODING UTF-8)
file(GLOB_RECURSE taskShaderFiles LIST_DIRECTORIES FALSE RELATIVE "${taskSource}"
    "${taskSource}/EngineResources/Shader/*")
if(NOT taskShaderFiles)
    message(FATAL_ERROR "Cue player shaders were not staged")
endif()
set(taskCopiedFiles "${CUE_PLAYER_EXECUTABLE_NAME}" "${CUE_STARTUP_SCENE_RELATIVE}"
    ${taskRuntimeFiles} ${taskLicenseFiles} ${taskShaderFiles})
set(taskNewOwned ${taskCopiedFiles} GameStartup.cueapp GamePackage.cuepackage)
list(REMOVE_DUPLICATES taskNewOwned)
set(taskOldOwned)
if(EXISTS "${taskOwnedList}")
    file(STRINGS "${taskOwnedList}" taskOldOwned ENCODING UTF-8)
endif()
foreach(taskRelative IN LISTS taskNewOwned taskOldOwned)
    cue_player_validate_relative("${taskRelative}")
endforeach()

# Copy 失敗でも既存の Editor / Source を保全し、部分的な Player の起動は拒否する
file(REMOVE "${taskMarker}")
foreach(taskRelative IN LISTS taskCopiedFiles)
    if(taskRelative STREQUAL CUE_PLAYER_EXECUTABLE_NAME)
        set(taskFrom "${CUE_PLAYER_EXECUTABLE}")
    elseif(taskRelative STREQUAL CUE_STARTUP_SCENE_RELATIVE)
        set(taskFrom "${CUE_STARTUP_SCENE}")
    else()
        set(taskFrom "${taskSource}/${taskRelative}")
    endif()
    if(NOT EXISTS "${taskFrom}" OR IS_DIRECTORY "${taskFrom}")
        message(FATAL_ERROR "Cue player staged file is missing: ${taskFrom}")
    endif()
    cue_player_validate_path("${taskFrom}")
    get_filename_component(taskParent "${taskOutput}/${taskRelative}" DIRECTORY)
    file(MAKE_DIRECTORY "${taskParent}")
    file(COPY_FILE "${taskFrom}" "${taskOutput}/${taskRelative}" ONLY_IF_DIFFERENT RESULT taskResult)
    if(NOT taskResult STREQUAL "0")
        message(FATAL_ERROR "Cue player copy failed: ${taskResult}")
    endif()
endforeach()

# 前回自身が公開した File だけを回収し、User が追加した File や他の Directory は削除しない
foreach(taskRelative IN LISTS taskOldOwned)
    if(NOT taskRelative IN_LIST taskNewOwned)
        if(IS_DIRECTORY "${taskOutput}/${taskRelative}")
            message(FATAL_ERROR "Cue old owned file was replaced by a directory")
        endif()
        file(REMOVE "${taskOutput}/${taskRelative}")
    endif()
endforeach()
file(READ "${CUE_STARTUP_TEMPLATE}" taskStartup)
string(APPEND taskStartup "configuration=${CUE_PLAYER_CONFIGURATION}\n")
file(READ "${CUE_PACKAGE_TEMPLATE}" taskPackage)
string(APPEND taskPackage "configuration=${CUE_PLAYER_CONFIGURATION}\n")
string(REPLACE ";" "\n" taskOwnedText "${taskNewOwned}")
string(APPEND taskOwnedText "\n")
cue_player_publish_text("${taskOutput}/GameStartup.cueapp" "${taskStartup}")
cue_player_publish_text("${taskOwnedList}" "${taskOwnedText}")
cue_player_publish_text("${taskMarker}" "${taskPackage}")
message(STATUS "Cue Player package: ${taskOutput}")
