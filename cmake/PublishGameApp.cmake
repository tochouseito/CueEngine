cmake_minimum_required(VERSION 4.2)

# 成功 Marker の公開までゲームを起動可能にしない。Source / Content を変更せず、専用 App だけを更新する
foreach(taskRequired IN ITEMS CUE_APP_SOURCE CUE_APP_EXECUTABLE CUE_APP_OUTPUT
    CUE_APP_CONFIGURATION CUE_APP_PROJECT_ID CUE_APP_APPLICATION CUE_APP_EXECUTABLE_NAME
    CUE_STARTUP_TEMPLATE CUE_PACKAGE_TEMPLATE CUE_STARTUP_SCENE CUE_STARTUP_SCENE_RELATIVE
    CUE_APP_RUNTIME_LIST CUE_APP_LICENSE_LIST)
    if(NOT DEFINED ${taskRequired} OR "${${taskRequired}}" STREQUAL "")
        message(FATAL_ERROR "Cue app publication argument is missing: ${taskRequired}")
    endif()
endforeach()
if(NOT CUE_APP_CONFIGURATION MATCHES "^(Debug|Development|Release)$")
    message(FATAL_ERROR "Cue app configuration is unsupported")
endif()
get_filename_component(taskOutput "${CUE_APP_OUTPUT}" ABSOLUTE)
get_filename_component(taskSource "${CUE_APP_SOURCE}" ABSOLUTE)
if(taskOutput STREQUAL taskSource OR NOT taskOutput MATCHES "/App$")
    message(FATAL_ERROR "Cue app publication requires a dedicated App directory")
endif()

# 出力先の Link / Junction と File を越えて書き込まない
function(cue_app_validate_path a_path)
    get_filename_component(taskPath "${a_path}" ABSOLUTE)
    while(NOT EXISTS "${taskPath}")
        get_filename_component(taskParent "${taskPath}" DIRECTORY)
        if(taskParent STREQUAL taskPath OR taskParent STREQUAL "")
            message(FATAL_ERROR "Cue app path has no existing parent")
        endif()
        set(taskPath "${taskParent}")
    endwhile()
    get_filename_component(taskReal "${taskPath}" REALPATH)
    string(TOLOWER "${taskPath}" taskExpected)
    string(TOLOWER "${taskReal}" taskActual)
    if(NOT taskExpected STREQUAL taskActual)
        message(FATAL_ERROR "Cue app path traverses a link or junction: ${a_path}")
    endif()
endfunction()

# 生成した相対 File 名だけを受け付け、前回の所有リストを削除 Command として解釈しない
function(cue_app_validate_relative a_relative)
    if(a_relative STREQUAL ".cue-app-owner" OR a_relative STREQUAL ".cue-app-files")
        message(FATAL_ERROR "Cue app ownership metadata cannot appear in the owned payload list")
    endif()
    if(a_relative STREQUAL "" OR IS_ABSOLUTE "${a_relative}" OR a_relative MATCHES "(^|/)\\.\\.(/|$)|:|\\\\|;|\\$<")
        message(FATAL_ERROR "Cue app owned file path is invalid: ${a_relative}")
    endif()
    get_filename_component(taskResolved "${taskOutput}/${a_relative}" ABSOLUTE)
    string(TOLOWER "${taskOutput}/" taskPrefix)
    string(TOLOWER "${taskResolved}" taskCompared)
    string(FIND "${taskCompared}" "${taskPrefix}" taskPosition)
    if(NOT taskPosition EQUAL 0)
        message(FATAL_ERROR "Cue app owned file is outside its directory")
    endif()
    cue_app_validate_path("${taskResolved}")
endfunction()

# 完成した File を同じ Directory の一意な一時名から公開する
function(cue_app_publish_text a_file a_text)
    string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef taskNonce)
    set(taskTemporary "${a_file}.${taskNonce}.tmp")
    file(WRITE "${taskTemporary}" "${a_text}")
    file(RENAME "${taskTemporary}" "${a_file}" RESULT taskResult)
    if(NOT taskResult STREQUAL "0")
        file(REMOVE "${taskTemporary}")
        message(FATAL_ERROR "Cue app file publication failed: ${taskResult}")
    endif()
endfunction()

cue_app_validate_path("${taskOutput}")
if(EXISTS "${taskOutput}" AND NOT IS_DIRECTORY "${taskOutput}")
    message(FATAL_ERROR "Cue App output is a regular file")
endif()
set(taskOwner "${taskOutput}/.cue-app-owner")
set(taskOwnedList "${taskOutput}/.cue-app-files")
set(taskMarker "${taskOutput}/GamePackage.cuepackage")
set(taskOwnerValue "${CUE_APP_PROJECT_ID}\n")
if(EXISTS "${taskOwner}")
    file(READ "${taskOwner}" taskPreviousOwner)
    if(NOT taskPreviousOwner STREQUAL taskOwnerValue)
        message(FATAL_ERROR "Cue App output belongs to another project")
    endif()
elseif(EXISTS "${taskOutput}")
    file(GLOB taskExisting LIST_DIRECTORIES TRUE "${taskOutput}/*" "${taskOutput}/.*")
    if(taskExisting)
        message(FATAL_ERROR "Cue will not overwrite a non-empty App directory without its owner marker")
    endif()
endif()
file(STRINGS "${CUE_APP_RUNTIME_LIST}" taskRuntimeFiles ENCODING UTF-8)
file(STRINGS "${CUE_APP_LICENSE_LIST}" taskLicenseFiles ENCODING UTF-8)
file(GLOB_RECURSE taskShaderFiles LIST_DIRECTORIES FALSE RELATIVE "${taskSource}"
    "${taskSource}/EngineResources/Shader/*")
if(NOT taskShaderFiles)
    message(FATAL_ERROR "Cue app shaders were not staged")
endif()
set(taskCopiedFiles "${CUE_APP_EXECUTABLE_NAME}" "${CUE_STARTUP_SCENE_RELATIVE}"
    ${taskRuntimeFiles} ${taskLicenseFiles} ${taskShaderFiles})
set(taskNewOwned ${taskCopiedFiles} GameStartup.cueapp GamePackage.cuepackage)
list(REMOVE_DUPLICATES taskNewOwned)
set(taskOldOwned)
if(EXISTS "${taskOwnedList}")
    file(STRINGS "${taskOwnedList}" taskOldOwned ENCODING UTF-8)
endif()
foreach(taskRelative IN LISTS taskNewOwned taskOldOwned)
    cue_app_validate_relative("${taskRelative}")
endforeach()

# 入力の確認と公開で同じ収録元を使う
function(cue_app_source_for a_relative a_output)
    if(a_relative STREQUAL CUE_APP_EXECUTABLE_NAME)
        set("${a_output}" "${CUE_APP_EXECUTABLE}" PARENT_SCOPE)
    elseif(a_relative STREQUAL CUE_STARTUP_SCENE_RELATIVE)
        set("${a_output}" "${CUE_STARTUP_SCENE}" PARENT_SCOPE)
    else()
        set("${a_output}" "${taskSource}/${a_relative}" PARENT_SCOPE)
    endif()
endfunction()

# 入力の更新と公開先の欠損を小さい Source に反映し、開発用 exe の再 Link を要求する
if(DEFINED CUE_APP_INPUTS_SOURCE)
    file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" taskFingerprint)
    set(taskNeedsRepair FALSE)
    foreach(taskInput IN ITEMS "${CUE_STARTUP_TEMPLATE}" "${CUE_PACKAGE_TEMPLATE}")
        file(SHA256 "${taskInput}" taskHash)
        string(APPEND taskFingerprint ";${taskHash}")
    endforeach()
    foreach(taskRelative IN LISTS taskNewOwned)
        if(NOT EXISTS "${taskOutput}/${taskRelative}" OR IS_DIRECTORY "${taskOutput}/${taskRelative}")
            set(taskNeedsRepair TRUE)
        endif()
    endforeach()
    foreach(taskRelative IN ITEMS GameStartup.cueapp GamePackage.cuepackage "${CUE_STARTUP_SCENE_RELATIVE}")
        if(NOT EXISTS "${taskSource}/${taskRelative}" OR IS_DIRECTORY "${taskSource}/${taskRelative}")
            set(taskNeedsRepair TRUE)
        endif()
    endforeach()
    if(NOT taskOldOwned STREQUAL taskNewOwned OR NOT EXISTS "${taskOwner}")
        set(taskNeedsRepair TRUE)
    endif()
    foreach(taskRelative IN LISTS taskCopiedFiles)
        # exe は後続の Link が生成する。その他の入力は同じ File から検知し公開する
        if(taskRelative STREQUAL CUE_APP_EXECUTABLE_NAME)
            continue()
        endif()
        cue_app_source_for("${taskRelative}" taskFrom)
        cue_app_validate_path("${taskFrom}")
        file(SHA256 "${taskFrom}" taskHash)
        string(APPEND taskFingerprint ";${taskRelative}=${taskHash}")
    endforeach()
    string(SHA256 taskHash "${taskFingerprint}")
    # 内容が同じ場合は時刻も保持し、完成済み App の無条件な再 Link を避ける
    file(CONFIGURE OUTPUT "${CUE_APP_INPUTS_SOURCE}" CONTENT "// Cue App package inputs: ${taskHash}\n" @ONLY)
    if(taskNeedsRepair)
        file(TOUCH "${CUE_APP_INPUTS_SOURCE}")
    endif()
    return()
endif()

file(READ "${CUE_STARTUP_TEMPLATE}" taskStartup)
string(APPEND taskStartup "configuration=${CUE_APP_CONFIGURATION}\n")
file(READ "${CUE_PACKAGE_TEMPLATE}" taskPackage)
string(APPEND taskPackage "configuration=${CUE_APP_CONFIGURATION}\n")
set(taskDebugMarker "${taskSource}/GamePackage.cuepackage")
set(taskDebugStartup "${taskSource}/GameStartup.cueapp")
set(taskDebugScene "${taskSource}/${CUE_STARTUP_SCENE_RELATIVE}")
foreach(taskDebugFile IN ITEMS "${taskDebugMarker}" "${taskDebugStartup}" "${taskDebugScene}")
    cue_app_validate_path("${taskDebugFile}")
endforeach()

# MSBuild が Link を省略して POST_BUILD だけ実行しても、同じ完成物を再公開しない
set(taskIsCurrent FALSE)
if(EXISTS "${taskOwner}" AND taskOldOwned STREQUAL taskNewOwned
   AND EXISTS "${taskMarker}" AND NOT IS_DIRECTORY "${taskMarker}"
   AND EXISTS "${taskOutput}/GameStartup.cueapp" AND NOT IS_DIRECTORY "${taskOutput}/GameStartup.cueapp"
   AND EXISTS "${taskDebugMarker}" AND NOT IS_DIRECTORY "${taskDebugMarker}"
   AND EXISTS "${taskDebugStartup}" AND NOT IS_DIRECTORY "${taskDebugStartup}"
   AND EXISTS "${taskDebugScene}" AND NOT IS_DIRECTORY "${taskDebugScene}")
    file(READ "${taskMarker}" taskPublishedPackage)
    file(READ "${taskOutput}/GameStartup.cueapp" taskPublishedStartup)
    file(READ "${taskDebugMarker}" taskDebugPackage)
    file(READ "${taskDebugStartup}" taskDebugConfig)
    file(SHA256 "${taskDebugScene}" taskDebugHash)
    file(SHA256 "${CUE_STARTUP_SCENE}" taskSceneHash)
    if(taskPublishedPackage STREQUAL taskPackage AND taskPublishedStartup STREQUAL taskStartup
       AND taskDebugPackage STREQUAL taskPackage AND taskDebugConfig STREQUAL taskStartup
       AND taskDebugHash STREQUAL taskSceneHash)
        set(taskIsCurrent TRUE)
        foreach(taskRelative IN LISTS taskCopiedFiles)
            cue_app_source_for("${taskRelative}" taskFrom)
            set(taskTo "${taskOutput}/${taskRelative}")
            if(NOT EXISTS "${taskTo}" OR IS_DIRECTORY "${taskTo}"
               OR NOT EXISTS "${taskFrom}" OR IS_DIRECTORY "${taskFrom}")
                set(taskIsCurrent FALSE)
                break()
            endif()
            cue_app_validate_path("${taskFrom}")
            file(SHA256 "${taskFrom}" taskSourceHash)
            file(SHA256 "${taskTo}" taskOutputHash)
            if(NOT taskSourceHash STREQUAL taskOutputHash)
                set(taskIsCurrent FALSE)
                break()
            endif()
        endforeach()
    endif()
endif()
if(taskIsCurrent)
    return()
endif()

file(MAKE_DIRECTORY "${taskOutput}")
cue_app_publish_text("${taskOwner}" "${taskOwnerValue}")

# Copy 失敗でも既存の Editor / Source を保全し、部分的な App の起動は拒否する
file(REMOVE "${taskMarker}")
# Open Folder で IDE が Link 出力を直接起動する場合も、失敗した Build では前回の完成 Marker を使わせない
file(REMOVE "${taskDebugMarker}")
foreach(taskRelative IN LISTS taskCopiedFiles)
    cue_app_source_for("${taskRelative}" taskFrom)
    if(NOT EXISTS "${taskFrom}" OR IS_DIRECTORY "${taskFrom}")
        message(FATAL_ERROR "Cue app staged file is missing: ${taskFrom}")
    endif()
    cue_app_validate_path("${taskFrom}")
    get_filename_component(taskParent "${taskOutput}/${taskRelative}" DIRECTORY)
    file(MAKE_DIRECTORY "${taskParent}")
    file(COPY_FILE "${taskFrom}" "${taskOutput}/${taskRelative}" ONLY_IF_DIFFERENT RESULT taskResult)
    if(NOT taskResult STREQUAL "0")
        message(FATAL_ERROR "Cue app copy failed: ${taskResult}")
    endif()
endforeach()

# 前回自身が公開した File だけを回収し、User が追加した File や他の Directory は削除しない
foreach(taskRelative IN LISTS taskOldOwned)
    if(NOT taskRelative IN_LIST taskNewOwned)
        if(IS_DIRECTORY "${taskOutput}/${taskRelative}")
            message(FATAL_ERROR "Cue old owned file was replaced by a directory")
        endif()
        file(REMOVE "${taskOutput}/${taskRelative}")
    endif()
endforeach()
string(REPLACE ";" "\n" taskOwnedText "${taskNewOwned}")
string(APPEND taskOwnedText "\n")
# Link 出力には Shader Runtime があるため、同じ Scene と起動設定を置けばデバッガーから直接起動できる
get_filename_component(taskDebugSceneDirectory "${taskDebugScene}" DIRECTORY)
file(MAKE_DIRECTORY "${taskDebugSceneDirectory}")
file(COPY_FILE "${taskOutput}/${CUE_STARTUP_SCENE_RELATIVE}" "${taskDebugScene}" ONLY_IF_DIFFERENT)
cue_app_publish_text("${taskDebugStartup}" "${taskStartup}")
cue_app_publish_text("${taskOutput}/GameStartup.cueapp" "${taskStartup}")
cue_app_publish_text("${taskOwnedList}" "${taskOwnedText}")
cue_app_publish_text("${taskDebugMarker}" "${taskPackage}")
cue_app_publish_text("${taskMarker}" "${taskPackage}")
message(STATUS "Cue App package: ${taskOutput}")
