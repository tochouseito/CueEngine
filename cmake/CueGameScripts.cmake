include_guard(GLOBAL)

# Source Map と登録関数の識別子を、生成する C++ へ混入しても文法にならない値から保護する
function(cue_validate_script_identifier a_name)
    string(LENGTH "${a_name}" taskLength)
    string(TOLOWER "${a_name}" taskLower)
    set(taskKeywords alignas alignof and and_eq asm auto bitand bitor bool break case catch char char8_t char16_t
        char32_t class compl concept const consteval constexpr constinit const_cast continue co_await co_return
        co_yield decltype default delete do double dynamic_cast else enum explicit export extern false float for
        friend goto if inline int long mutable namespace new noexcept not not_eq nullptr operator or or_eq private
        protected public register reinterpret_cast requires return short signed sizeof static static_assert
        static_cast struct switch template this thread_local throw true try typedef typeid typename union unsigned
        using virtual void volatile wchar_t while xor xor_eq)
    set(taskWindows con prn aux nul)
    if(taskLength GREATER 64 OR NOT "${a_name}" MATCHES "^[A-Za-z][A-Za-z0-9_]*$"
       OR "${a_name}" MATCHES "__" OR a_name IN_LIST taskKeywords OR taskLower IN_LIST taskWindows
       OR taskLower MATCHES "^(com|lpt)[1-9]$")
        message(FATAL_ERROR "Cue script registration identifier is invalid: ${a_name}")
    endif()
endfunction()

# 管理する対応表の Source だけを Build し、共通 C ABI 入口は Binary Tree に一度だけ生成する
function(cue_add_game_scripts a_target)
    if(ARGC GREATER 1)
        message(FATAL_ERROR "cue_add_game_scripts accepts only the game target")
    endif()
    set(taskMap "${CMAKE_CURRENT_SOURCE_DIR}/ScriptSources.cueide")
    cue_validate_real_path("${taskMap}")
    if(NOT EXISTS "${taskMap}" OR IS_DIRECTORY "${taskMap}")
        message(FATAL_ERROR "Cue ScriptSources.cueide is missing")
    endif()
    file(SIZE "${taskMap}" taskSize)
    if(taskSize GREATER 65536)
        message(FATAL_ERROR "Cue script source map exceeds 64 KiB")
    endif()
    file(READ "${taskMap}" taskHex HEX)
    cue_validate_project_utf8("${taskHex}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${taskMap}")
    file(STRINGS "${taskMap}" taskLines ENCODING UTF-8)
    set(taskSeen)
    set(taskTypes)
    set(taskComparedTypes)
    set(taskRegistrationTypes)
    set(taskSources)
    set(taskSourceNames)
    set(taskSymbols)
    set(taskVersion "")
    foreach(taskLine IN LISTS taskLines)
        string(STRIP "${taskLine}" taskLine)
        if(taskLine STREQUAL "" OR taskLine MATCHES "^#")
            continue()
        endif()
        if(taskLine MATCHES ";|\\$|[<>]")
            message(FATAL_ERROR "Cue script source map contains build expressions")
        endif()
        if(NOT taskLine MATCHES "^([^=]+)=(.*)$")
            message(FATAL_ERROR "Cue script source map has an invalid line")
        endif()
        string(STRIP "${CMAKE_MATCH_1}" taskKey)
        string(STRIP "${CMAKE_MATCH_2}" taskValue)
        if(taskKey IN_LIST taskSeen OR taskValue STREQUAL "")
            message(FATAL_ERROR "Cue script source map has a duplicate or empty entry")
        endif()
        list(APPEND taskSeen "${taskKey}")
        if(taskKey STREQUAL "formatVersion")
            set(taskVersion "${taskValue}")
            continue()
        endif()
        if(NOT taskKey MATCHES "^(script|registration)\.([A-Za-z][A-Za-z0-9_.]*)$")
            message(FATAL_ERROR "Cue script source map has an unknown key: ${taskKey}")
        endif()
        set(taskKind "${CMAKE_MATCH_1}")
        set(taskType "${CMAKE_MATCH_2}")
        string(LENGTH "${taskType}" taskTypeLength)
        if(taskTypeLength GREATER 128)
            message(FATAL_ERROR "Cue script type ID exceeds its limit")
        endif()
        string(SHA256 taskHash "${taskType}")
        if(taskKind STREQUAL "script")
            # 相対 cpp のみを許し、通常 File と Source 内配置を要求する
            string(LENGTH "${taskValue}" taskPathLength)
            if(taskPathLength GREATER 2048 OR IS_ABSOLUTE "${taskValue}" OR NOT taskValue MATCHES "\\.cpp$"
               OR taskValue MATCHES "[:\\\\\"|?*]|(^|/)\\.?\\.?(/|$)|(^/)|(/$)|//|[. ](/|$)")
                message(FATAL_ERROR "Cue script source path is invalid: ${taskValue}")
            endif()
            string(REPLACE "/" ";" taskParts "${taskValue}")
            foreach(taskPart IN LISTS taskParts)
                string(TOLOWER "${taskPart}" taskLowerPart)
                string(REGEX REPLACE "\\..*$" "" taskBase "${taskLowerPart}")
                if(taskBase MATCHES "^(con|prn|aux|nul|com[1-9]|lpt[1-9])$")
                    message(FATAL_ERROR "Cue script source path uses a Windows reserved name")
                endif()
            endforeach()
            get_filename_component(taskSource "${CMAKE_CURRENT_SOURCE_DIR}/${taskValue}" ABSOLUTE)
            cue_path_is_within("${CMAKE_CURRENT_SOURCE_DIR}" "${taskSource}" taskInside)
            cue_validate_real_path("${taskSource}")
            if(NOT taskInside OR NOT EXISTS "${taskSource}" OR IS_DIRECTORY "${taskSource}")
                message(FATAL_ERROR "Cue script source is missing or outside Source")
            endif()
            string(TOLOWER "${taskValue}" taskComparedSource)
            string(TOLOWER "${taskType}" taskComparedType)
            if(taskComparedSource IN_LIST taskSourceNames OR taskComparedType IN_LIST taskComparedTypes)
                message(FATAL_ERROR "Cue script source or type ID has a case-insensitive collision")
            endif()
            list(APPEND taskSourceNames "${taskComparedSource}")
            list(APPEND taskComparedTypes "${taskComparedType}")
            list(APPEND taskTypes "${taskType}")
            list(APPEND taskSources "${taskSource}")
        else()
            cue_validate_script_identifier("${taskValue}")
            string(TOLOWER "${taskValue}" taskComparedSymbol)
            if(taskComparedSymbol IN_LIST taskSymbols)
                message(FATAL_ERROR "Cue script registration symbol is duplicated")
            endif()
            list(APPEND taskSymbols "${taskComparedSymbol}")
            list(APPEND taskRegistrationTypes "${taskType}")
            set("taskRegistration_${taskHash}" "${taskValue}")
        endif()
    endforeach()
    list(LENGTH taskTypes taskCount)
    list(LENGTH taskRegistrationTypes taskRegistrationCount)
    if(NOT taskVersion STREQUAL "2" OR taskCount EQUAL 0 OR taskCount GREATER 256
       OR NOT taskCount EQUAL taskRegistrationCount)
        message(FATAL_ERROR "Cue automatic script registration requires a nonempty, paired v2 source map")
    endif()
    set(taskEntry "#include <Script/ModuleEntry.h>\n\n")
    set(taskCalls)
    foreach(taskType IN LISTS taskTypes)
        if(NOT taskType IN_LIST taskRegistrationTypes)
            message(FATAL_ERROR "Cue script source has no registration")
        endif()
        string(SHA256 taskHash "${taskType}")
        set(taskSymbol "${taskRegistration_${taskHash}}")
        string(APPEND taskEntry "::cue::ScriptRegistration CueScriptRegister_${taskSymbol}();\n")
        list(APPEND taskCalls "CueScriptRegister_${taskSymbol}()")
    endforeach()
    string(JOIN ",\n    " taskCalls ${taskCalls})
    string(APPEND taskEntry "\n// Script の登録関数を明示参照し、Static Link でも型を保持する\nCUE_DEFINE_SCRIPT_MODULE(\n    ${taskCalls})\n")
    set(taskGenerated "${CMAKE_CURRENT_BINARY_DIR}/Generated/ScriptModule.cpp")
    cue_validate_generated_directory("${CMAKE_CURRENT_BINARY_DIR}/Generated")
    cue_validate_real_path("${taskGenerated}")
    file(CONFIGURE OUTPUT "${taskGenerated}" CONTENT "${taskEntry}" @ONLY)
    cue_add_game_module("${a_target}" SOURCES ${taskSources} "${taskGenerated}")
endfunction()
