# Configure だけでは Manifest を出さず、両成果物の Link 完了後にだけ実行する
foreach(taskRequired IN ITEMS CUE_MANIFEST_TEMPLATE CUE_MANIFEST_OUTPUT CUE_GAME_MODULE CUE_GAME_STATIC
                             CUE_EXPECTED_MODULE CUE_EXPECTED_STATIC)
    if(NOT DEFINED ${taskRequired} OR "${${taskRequired}}" STREQUAL "")
        message(FATAL_ERROR "Cue manifest publication argument is missing: ${taskRequired}")
    endif()
endforeach()
get_filename_component(taskModule "${CUE_GAME_MODULE}" ABSOLUTE)
get_filename_component(taskExpectedModule "${CUE_EXPECTED_MODULE}" ABSOLUTE)
get_filename_component(taskStatic "${CUE_GAME_STATIC}" ABSOLUTE)
get_filename_component(taskExpectedStatic "${CUE_EXPECTED_STATIC}" ABSOLUTE)
string(TOLOWER "${taskModule}" taskModule)
string(TOLOWER "${taskExpectedModule}" taskExpectedModule)
string(TOLOWER "${taskStatic}" taskStatic)
string(TOLOWER "${taskExpectedStatic}" taskExpectedStatic)
if(NOT taskModule STREQUAL taskExpectedModule OR NOT taskStatic STREQUAL taskExpectedStatic)
    message(FATAL_ERROR "Cue artifact locations were overridden and no longer match the project contract")
endif()
if(NOT EXISTS "${CUE_GAME_MODULE}" OR IS_DIRECTORY "${CUE_GAME_MODULE}"
   OR NOT EXISTS "${CUE_GAME_STATIC}" OR IS_DIRECTORY "${CUE_GAME_STATIC}")
    message(FATAL_ERROR "Cue game artifacts are incomplete")
endif()
file(READ "${CUE_MANIFEST_TEMPLATE}" taskManifest)
file(SHA256 "${CUE_GAME_MODULE}" taskModuleHash)
file(SHA256 "${CUE_GAME_STATIC}" taskStaticHash)
string(APPEND taskManifest "moduleSha256=${taskModuleHash}\nstaticLibrarySha256=${taskStaticHash}\n")
get_filename_component(taskDirectory "${CUE_MANIFEST_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${taskDirectory}")
# 固定の一時名を使わず、別 Build Tree との衝突と半端な Manifest の公開を避ける
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef taskNonce)
set(taskTemporary "${CUE_MANIFEST_OUTPUT}.${taskNonce}.tmp")
file(WRITE "${taskTemporary}" "${taskManifest}")
file(RENAME "${taskTemporary}" "${CUE_MANIFEST_OUTPUT}" RESULT taskResult)
if(NOT taskResult STREQUAL "0")
    file(REMOVE "${taskTemporary}")
    message(FATAL_ERROR "Cue manifest publication failed: ${taskResult}")
endif()
