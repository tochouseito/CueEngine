{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-vs2026",
            "displayName": "Windows x64 - Visual Studio 2026",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Development;Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-vs2026-debug",
            "configurePreset": "windows-vs2026",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2026-development",
            "configurePreset": "windows-vs2026",
            "configuration": "Development"
        },
        {
            "name": "windows-vs2026-release",
            "configurePreset": "windows-vs2026",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-vs2026-debug",
            "configurePreset": "windows-vs2026",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-vs2026-development",
            "configurePreset": "windows-vs2026",
            "configuration": "Development",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-vs2026-release",
            "configurePreset": "windows-vs2026",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
