<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <StartupObject>Cue.Hub.App</StartupObject>
        <AssemblyName>CueHub</AssemblyName>
        <RootNamespace>Cue.Hub</RootNamespace>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PlatformTarget>x64</PlatformTarget>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CueVersionJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Version.json'))</CueVersionJson>
        <Version>$([System.Text.RegularExpressions.Regex]::Match('$(CueVersionJson)', '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Core/**" />
        <EmbeddedResource Remove="Core/**" />
        <None Remove="Core/**" />
        <Page Remove="Core/**" />
        <ApplicationDefinition Remove="App.xaml" />
        <Page Include="App.xaml" />
        <ProjectReference Include="Core/CueHub.Core.csproj" />
    </ItemGroup>
</Project>
