<Application x:Class="Cue.Hub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
                <ResourceDictionary Source="Themes/Hub.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="MinWidth" Value="86" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxBaseStyle}">
                <Setter Property="Padding" Value="6" />
                <Setter Property="Margin" Value="0,3,0,10" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Padding" Value="5" />
                <Setter Property="Margin" Value="0,3,0,10" />
            </Style>
            <Style TargetType="GroupBox" BasedOn="{StaticResource DefaultGroupBoxStyle}">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
