<UserControl x:Class="Cue.Hub.InstallationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IdleAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="インストール" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="AddEngineButton" Content="リストに追加 ▾" Click="on_add_engine" Style="{StaticResource IdleAction}" Margin="0,0,8,0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="ローカル Engine を登録" Command="{Binding RegisterEngine}" />
                            <MenuItem Header="パッケージから導入" Command="{Binding ImportEngine}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="InstallEngineButton" Content="Engine をインストール" Click="on_install_engine"
                        Style="{StaticResource IdleAction}" FontWeight="SemiBold" Margin="0" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="検索" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="EngineSearchBox" Text="{Binding EngineSearch, UpdateSourceTrigger=PropertyChanged}"
                     Width="280" AutomationProperties.Name="インストール済み Engine を検索" />
        </StackPanel>
        <TabControl x:Name="InstalledChannelTabs" Grid.Row="2" SelectedIndex="{Binding InstalledChannel}" Margin="0,0,0,16">
            <TabItem Header="すべて" /><TabItem Header="正式リリース" /><TabItem Header="Preview" />
        </TabControl>
        <Grid Grid.Row="3" MinHeight="160">
            <ListBox x:Name="InstalledEngineList" ItemsSource="{Binding InstalledEngines}"
                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="インストール済み Engine">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" TextElement.Foreground="#172236" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="6" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Version, StringFormat=CueEngine {0}}" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Root}" ToolTip="{Binding Root}" TextTrimming="CharacterEllipsis" Foreground="#586273" Margin="0,8,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Windows x64" Background="#EEF2F7" Padding="6,3" Margin="0,0,8,0" />
                                        <TextBlock Background="#EEF2F7" Padding="6,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="ローカル開発版" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsManaged}" Value="True"><Setter Property="Text" Value="導入版" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="管理 ▾" Click="on_manage_engine" VerticalAlignment="Top" Margin="0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="エクスプローラーで表示" Command="{Binding ShowEngineFolder}" />
                                            <MenuItem Header="修復" Command="{Binding RepairEngine}" />
                                            <Separator />
                                            <MenuItem Command="{Binding RemoveEngine}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="一覧から登録解除" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedEngine.IsManaged}" Value="True"><Setter Property="Header" Value="アンインストール" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="表示する Engine がありません。右上の「リストに追加」または「Engine をインストール」から導入できます。"
                       TextWrapping="Wrap" Foreground="#586273" Margin="20" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding InstalledEngines.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
