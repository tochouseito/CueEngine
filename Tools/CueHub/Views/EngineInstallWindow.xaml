<Window x:Class="Cue.Hub.EngineInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Engine をインストール" Width="860" Height="630" MinWidth="650" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Yu Gothic UI" FontSize="14">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Engine をインストール" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20" />
        <TabControl x:Name="CatalogChannelTabs" DockPanel.Dock="Top" SelectedIndex="{Binding CatalogChannel}" Margin="0,0,0,16">
            <TabItem Header="正式リリース" /><TabItem Header="Preview" IsEnabled="{Binding IncludePreview}" />
        </TabControl>
        <TextBlock DockPanel.Dock="Top" Text="正式版・Preview 合計の最新 10 世代。Preview の表示は設定で有効にできます。" TextWrapping="Wrap" Foreground="#586273" Margin="0,0,0,16" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
            <Button DockPanel.Dock="Right" Content="キャンセル" IsCancel="True" Margin="0" />
            <Button Content="GitHub の過去版" Command="{Binding OpenArchive}" HorizontalAlignment="Left" />
            <Button Content="パッケージから導入" Command="{Binding ImportEngine}" HorizontalAlignment="Left" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Content="一覧を更新" Command="{Binding RefreshCatalog}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="公開版の取得状況" />
        </StackPanel>
        <Grid>
            <ListBox x:Name="AvailableReleaseList" ItemsSource="{Binding AvailableReleases}" SelectedItem="{Binding SelectedRelease}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" AutomationProperties.Name="インストール可能な Engine">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" TextElement.Foreground="#172236" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="6" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Version, StringFormat=CueEngine {0}}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PublishedUtc, StringFormat=公開日: {0:yyyy-MM-dd}}" Foreground="#586273" Margin="0,8,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="インストール" Click="on_install_release" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="この区分の公開版はありません。一覧の更新、Preview、または GitHub の過去版を確認してください。"
                       TextWrapping="Wrap" Foreground="#586273" Margin="16" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding AvailableReleases.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
