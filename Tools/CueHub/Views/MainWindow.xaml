<Window x:Class="Cue.Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cue.Hub"
        Title="CueEngine Hub" Width="1120" Height="800" MinWidth="850" MinHeight="620"
        Background="{DynamicResource HubBackground}" Foreground="{DynamicResource HubForeground}"
        FontFamily="Yu Gothic UI" FontSize="14" Closing="on_closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <Style x:Key="NavigationItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="10,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavigationBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter x:Name="NavigationHeader" ContentSource="Header" RecognizesAccessKey="True"
                                              TextElement.Foreground="{DynamicResource HubNavigationForeground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HubNavigationHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HubNavigationSelected}" />
                                <Setter TargetName="NavigationHeader" Property="TextElement.Foreground" Value="{DynamicResource HubNavigationHeading}" />
                                <Setter TargetName="NavigationHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="{DynamicResource HubNavigationFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HubSurface}" Padding="12" Margin="0,14,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="取消" Command="{Binding Cancel}" Margin="14,0,0,0" />
                <StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="操作結果" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,8,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- TabControl の選択・キー操作を使い、見出しを左のナビゲーションとして配置する -->
        <TabControl x:Name="Navigation" TabStripPlacement="Left" Background="{DynamicResource HubBackground}"
                    ItemContainerStyle="{StaticResource NavigationItem}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="196" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource HubNavigationBackground}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="28,28,18,28">
                                    <TextBlock Text="CUE ENGINE" Foreground="{DynamicResource HubNavigationMuted}" FontSize="12" />
                                    <TextBlock Text="Hub" Foreground="{DynamicResource HubNavigationHeading}" FontSize="30" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Version, StringFormat=Version {0}}"
                                           Foreground="{DynamicResource HubNavigationMuted}" Margin="18,24" TextWrapping="Wrap" />
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{TemplateBinding Background}" Padding="24,24,24,8">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="プロジェクト">
                <Grid Margin="8">
                    <Grid x:Name="ProjectListPage">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProjectCreationOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="プロジェクト" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="AddProjectButton" Content="追加" Command="{Binding RegisterProject}" Margin="0,0,8,0"
                                        ToolTip="既存の .cueproj を選択して一覧に追加します" />
                                <Button x:Name="NewProjectButton" Content="新しいプロジェクト" Command="{Binding ShowProjectCreation}"
                                        FontWeight="SemiBold" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Grid.Row="1">
                            <Button Content="Editor で開く" Command="{Binding OpenProject}" />
                            <Button x:Name="ChangeProjectEngineButton" Content="Engine バージョンを変更" Command="{Binding ChangeProjectEngine}" />
                            <Button Content="一覧から外す" Command="{Binding RemoveProject}" />
                        </WrapPanel>
                        <Grid Grid.Row="2" MinHeight="120">
                            <ListView x:Name="ProjectList" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                      SelectionMode="Single" AutomationProperties.Name="登録済みプロジェクト">
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="180" />
                                        <GridViewColumn Header="Engine バージョン" DisplayMemberBinding="{Binding EngineVersion}" Width="150" />
                                        <GridViewColumn Header="保存場所" Width="460">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding ProjectFile}" ToolTip="{Binding ProjectFile}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Text="登録済みのプロジェクトはありません。右上の「追加」または「新しいプロジェクト」から始めてください。"
                                       TextWrapping="Wrap" Foreground="{DynamicResource HubMutedForeground}" Margin="20,60,20,20" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <local:ProjectCreationView x:Name="ProjectCreationPage"
                                               Visibility="{Binding IsProjectCreationOpen, Converter={StaticResource BooleanVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem Header="インストール">
                <local:InstallationsView x:Name="InstallationsPage" Margin="8" />
            </TabItem>
            <TabItem Header="設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="設定" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <GroupBox Header="外観">
                            <StackPanel>
                                <Label Content="テーマ" Target="{Binding ElementName=ThemeSelector}" Padding="0" />
                                <ComboBox x:Name="ThemeSelector" AutomationProperties.Name="テーマ" Width="180"
                                          HorizontalAlignment="Left" SelectedValuePath="Tag"
                                          SelectedValue="{Binding Theme, Mode=TwoWay}">
                                    <ComboBoxItem Content="ライト" Tag="light" />
                                    <ComboBoxItem Content="ダーク" Tag="dark" />
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Engine の保存先"><StackPanel><TextBox Text="{Binding EngineDirectory, UpdateSourceTrigger=PropertyChanged}" /><Button Content="フォルダを選択" Command="{Binding ChooseEngineDirectory}" HorizontalAlignment="Left" /></StackPanel></GroupBox>
                        <GroupBox Header="配布物を検証する発行者公開鍵"><StackPanel><TextBlock Text="配布元から確認した公開鍵だけを指定してください。ダウンロードしたパッケージ内の鍵は自動登録しません。" TextWrapping="Wrap" /><TextBox Text="{Binding KeyFile, UpdateSourceTrigger=PropertyChanged}" /><Button Content="公開鍵を選択" Command="{Binding ChooseKeyFile}" HorizontalAlignment="Left" /></StackPanel></GroupBox>
                        <CheckBox Content="Preview を表示・更新候補に含める" IsChecked="{Binding IncludePreview}" Margin="0,0,0,15" />
                        <GroupBox Header="Hub 自身の更新"><StackPanel><TextBlock Text="通常は空欄で GitHub から取得します。オフライン更新では署名済み Feed のフォルダを指定できます。" TextWrapping="Wrap" /><TextBox Text="{Binding LocalFeed, UpdateSourceTrigger=PropertyChanged}" /><WrapPanel><Button Content="ローカル Feed を選択" Command="{Binding ChooseLocalFeed}" /><Button Content="Hub 更新を確認・準備" Command="{Binding UpdateHub}" /></WrapPanel></StackPanel></GroupBox>
                        <Button Content="設定を保存" Command="{Binding SaveSettings}" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
